---
import { ArrowDown, ArrowUpRight } from 'lucide-astro'; import { hotel } from '../data/hotel'; import { bookingHref, bookingLabel } from '../lib/booking';
---
<section class="relative min-h-[760px] overflow-hidden bg-[var(--ink)] text-white"><img src={hotel.primaryImage} alt={hotel.name} class="absolute inset-0 h-full w-full object-cover"/><div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/25 to-black/25"></div><div class="container-hotel relative flex min-h-[760px] items-end pb-28 pt-36"><div class="max-w-4xl reveal"><p class="eyebrow mb-6 text-white/75">{hotel.address.city || 'Destination'} · {hotel.propertyType}</p><h1 class="font-display serif-balance text-6xl leading-[.88] tracking-[-.035em] sm:text-8xl lg:text-[9rem]">{hotel.tagline}</h1><p class="mt-8 max-w-xl text-base leading-7 text-white/80 sm:text-lg">{hotel.shortDescription}</p><div class="mt-9 flex flex-wrap gap-3"><a href={bookingHref()} class="focus-ring inline-flex items-center gap-3 bg-white px-6 py-4 text-xs font-bold uppercase tracking-[.16em] text-[var(--ink)]">{bookingLabel()} <ArrowUpRight size={16}/></a><a href="#story" class="focus-ring inline-flex items-center gap-3 border border-white/50 px-6 py-4 text-xs font-bold uppercase tracking-[.16em]">Discover the stay <ArrowDown size={16}/></a></div></div></div><div class="absolute bottom-6 right-6 hidden text-right text-xs text-white/60 md:block">Scroll to explore<br/><span class="inline-block pt-2">↓</span></div></section>
