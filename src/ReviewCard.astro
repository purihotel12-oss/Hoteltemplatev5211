---
import type { Review } from '../data/types';
const { review } = Astro.props as { review: Review };
---
<blockquote class="py-9 text-center"><p class="font-display text-3xl leading-tight sm:text-4xl">“{review.reviewText}”</p><footer class="mt-5 text-xs uppercase tracking-[.16em] text-[var(--muted)]">{review.guestName} · {review.source}{review.rating ? ` · ${review.rating}/5` : ''}</footer></blockquote>
