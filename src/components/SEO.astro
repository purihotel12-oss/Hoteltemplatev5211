---
import { hotel } from '../data/hotel';
import { pageSEO } from '../lib/seo';
const { title, description, canonical, ogImage } = pageSEO(Astro.props.title, Astro.props.description, Astro.url.pathname);
const robots = Astro.props.robots || hotel.seo.robots || 'index,follow';
const ogTitle = hotel.seo.ogTitle || title;
const ogDescription = hotel.seo.ogDescription || description;
---
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />
<meta property="og:type" content="website" />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={ogDescription} />
<meta name="twitter:image" content={ogImage} />
