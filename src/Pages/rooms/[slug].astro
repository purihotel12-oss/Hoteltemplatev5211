---
import { features } from '../../data/features';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RoomGallery from '../../components/RoomGallery.astro';
import { rooms } from '../../data/rooms';
import { bookingHref, bookingLabel } from '../../lib/booking';
import { breadcrumbJsonLd } from '../../lib/structuredData';
import BookingCTA from '../../components/BookingCTA.astro';
if (!features.rooms) return Astro.redirect('/404');
export function getStaticPaths(){return rooms.map(room=>({params:{slug:room.slug},props:{room}}))};
const {room}=Astro.props;
const crumbs=[{name:'Home',url:'/'},{name:'Rooms',url:'/rooms'},{name:room.name}];
---
<BaseLayout title={room.name} description={room.description} jsonLd={breadcrumbJsonLd(crumbs)}><section class="pt-36 pb-24"><div class="container-hotel"><Breadcrumbs items={crumbs}/><div class="mt-8 grid gap-10 lg:grid-cols-[1.2fr_.8fr]"><RoomGallery room={room}/><div class="lg:sticky lg:top-28 lg:self-start"><p class="eyebrow text-[var(--accent)]">Room</p><h1 class="font-display mt-4 text-6xl leading-[.9]">{room.name}</h1><p class="mt-6 text-base leading-7 text-[var(--muted)]">{room.longDescription}</p><div class="mt-8 grid grid-cols-2 border-y border-black/10 text-sm">{[['Guests',room.guests],['Size',room.roomSize],['Bed',room.bedType],['View',room.view],['Bathrooms',room.bathrooms],['Meal plan',room.mealPlan]].filter(x=>x[1]).map(x=><div class="border-b border-r border-black/10 p-4"><div class="text-xs text-[var(--muted)]">{x[0]}</div><div class="mt-1">{x[1]}</div></div>)}</div><div class="mt-8 flex flex-wrap gap-3"><BookingCTA label={bookingLabel()} context={room.name} />{room.enquiryEnabled&&<a href="/contact" class="focus-ring border border-black/15 px-6 py-4 text-xs font-bold uppercase tracking-[.16em]">Enquire</a>}</div></div></div><div class="mt-20 grid gap-14 lg:grid-cols-[.7fr_1.3fr]"><div><p class="eyebrow text-[var(--accent)]">Facilities</p></div><div class="grid gap-3 sm:grid-cols-2">{room.amenities.map(a=><div class="border-t border-black/10 py-4 text-sm">{a}</div>)}</div></div></div></section></BaseLayout>
