---
import type { GalleryItem } from '../data/types';
const { items } = Astro.props as { items: GalleryItem[] };
---
<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">{items.map(item => <a href={item.image} class="group block overflow-hidden" aria-label={item.caption || `View ${item.alt}`}><img src={item.image} alt={item.alt} width={item.width || 1200} height={item.height || 900} loading="lazy" class="aspect-[4/3] w-full object-cover transition duration-700 group-hover:scale-[1.025]" />{item.caption && <span class="mt-2 block text-xs text-[var(--muted)]">{item.caption}</span>}</a>)}</div>
