---
import { features } from '../../data/features';
import BaseLayout from '../../layouts/BaseLayout.astro'; import SectionHeading from '../../components/SectionHeading.astro'; import { offers } from '../../data/offers';
const today = new Date();
const validOffers = offers.filter(o => (!o.validFrom || new Date(o.validFrom) <= today) && (!o.validUntil || new Date(o.validUntil) >= today));
if (!features.offers) return Astro.redirect('/404');
---
<BaseLayout title="Offers"><section class="pt-40 pb-28"><div class="container-hotel"><SectionHeading eyebrow="Offers" title="Current stays and packages"/>{validOffers.length===0?<p class="mt-14 text-sm text-[var(--muted)]">No offers are configured. This module is intentionally hidden in the master template by default.</p>:<div class="mt-14 grid gap-10 md:grid-cols-2">{validOffers.map(o=><article><h2 class="font-display text-4xl">{o.title}</h2><p class="mt-3 text-sm text-[var(--muted)]">{o.description}</p></article>)}</div>}</div></section></BaseLayout>
