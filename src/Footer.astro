---
import { ArrowUpRight } from 'lucide-astro'; import { hotel } from '../data/hotel'; import { features } from '../data/features'; import { social } from '../data/social';
import SocialLinks from './SocialLinks.astro';
---
<footer class="bg-[var(--ink)] text-white"><div class="container-hotel py-20 sm:py-28"><div class="grid gap-14 lg:grid-cols-[1.4fr_.7fr_.7fr] lg:gap-20"><div><p class="eyebrow text-white/50">{hotel.propertyType}</p><h2 class="font-display mt-5 max-w-2xl text-6xl leading-[.9]">Stay somewhere worth remembering.</h2><p class="mt-6 max-w-lg text-sm leading-7 text-white/60">{hotel.shortDescription}</p></div><div><p class="eyebrow text-white/40">Explore</p><div class="mt-6 grid gap-3 text-sm">{features.rooms&&<a href="/rooms">Rooms</a>}{features.experiences&&<a href="/experiences">Experiences</a>}{features.gallery&&<a href="/gallery">Gallery</a>}<a href="/about">About</a><a href="/contact">Contact</a>{features.offers&&<a href="/offers">Offers</a>}{features.blog&&<a href="/blog">Journal</a>}{features.corporateEvents&&<a href="/corporate-events">Corporate events</a>}{features.giftVouchers&&<a href="/gift-vouchers">Gift vouchers</a>}{features.careers&&<a href="/careers">Careers</a>}</div></div><div><p class="eyebrow text-white/40">Guest information</p><div class="mt-6 grid gap-3 text-sm">{features.guestInformation&&<a href="/guest-information">Guest information</a>}{features.faq&&<a href="/faq">FAQ</a>}<a href="/privacy-policy">Privacy</a><a href="/refund-policy">Refunds</a><a href="/terms-and-conditions">Terms</a><a href="/cookie-policy">Cookies</a></div></div></div><div class="mt-20 flex flex-col gap-5 border-t border-white/15 pt-6 text-xs text-white/50 sm:flex-row sm:items-center sm:justify-between"><span>© {new Date().getFullYear()} {hotel.name}</span><SocialLinks links={social.map(s => ({ ...s, label: s.platform }))} /><span>DEMO CONTENT — REPLACE BEFORE PRODUCTION</span></div></div></footer>
