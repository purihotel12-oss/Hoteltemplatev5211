---
import { features } from '../data/features';
import BaseLayout from '../layouts/BaseLayout.astro'; import SectionHeading from '../components/SectionHeading.astro';
import AmenityCard from '../components/AmenityCard.astro'; import { amenities } from '../data/amenities';
if (!features.amenities) return Astro.redirect('/404');
---
<BaseLayout title="Amenities"><section class="pt-40 pb-28"><div class="container-hotel"><SectionHeading eyebrow="Amenities" title="The details that make a stay easier"/><div class="mt-14 grid border-t border-black/10 sm:grid-cols-2 lg:grid-cols-3">{amenities.map(a=><AmenityCard amenity={a}/>)}</div></div></section></BaseLayout>
