---
import type { Room } from '../data/types';
const { room } = Astro.props as { room: Room };
---
<div class="grid gap-3 sm:grid-cols-2">
  {room.images.map((image, i) => (
    <img src={image} alt={room.imageAlt[i] || room.name} width="1200" height="900" loading={i === 0 ? 'eager' : 'lazy'} class={`aspect-[4/3] w-full object-cover ${i === 0 ? 'sm:col-span-2' : ''}`} />
  ))}
</div>
