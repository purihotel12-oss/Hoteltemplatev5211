---
import { CalendarDays, Users, ArrowUpRight } from 'lucide-astro'; import { bookingHref, bookingLabel } from '../lib/booking';
---
<section class="relative z-20 -mt-12"><div class="container-hotel"><div class="grid overflow-hidden border border-black/10 bg-white shadow-[0_18px_60px_rgba(0,0,0,.12)] md:grid-cols-[1fr_1fr_1fr_auto]"><div class="border-b p-5 md:border-b-0 md:border-r"><div class="eyebrow text-[var(--muted)]">Check in</div><div class="mt-2 flex items-center gap-2 text-sm"><CalendarDays size={17}/> Select date</div></div><div class="border-b p-5 md:border-b-0 md:border-r"><div class="eyebrow text-[var(--muted)]">Check out</div><div class="mt-2 flex items-center gap-2 text-sm"><CalendarDays size={17}/> Select date</div></div><div class="border-b p-5 md:border-b-0 md:border-r"><div class="eyebrow text-[var(--muted)]">Guests</div><div class="mt-2 flex items-center gap-2 text-sm"><Users size={17}/> 2 guests</div></div><a href={bookingHref('booking widget')} class="flex items-center justify-center gap-2 bg-[var(--primary,#283127)] px-8 py-5 text-xs font-bold uppercase tracking-[.16em] text-white hover:opacity-90">{bookingLabel()} <ArrowUpRight size={16}/></a></div></div></section>
