---
import BaseLayout from '../layouts/BaseLayout.astro'; import SectionHeading from '../components/SectionHeading.astro'; import { hotel } from '../data/hotel';
---
<BaseLayout title="About"><section class="pt-40 pb-28"><div class="container-hotel"><SectionHeading eyebrow="About" title="A hospitality story worth telling" description={hotel.longDescription}/><div class="mt-16 grid gap-5 md:grid-cols-2"><img src={hotel.primaryImage} alt={hotel.name} class="aspect-[4/3] w-full object-cover"/><div class="bg-[var(--surface)] p-10 sm:p-14"><p class="eyebrow text-[var(--accent)]">DEMO CONTENT</p><h2 class="font-display mt-6 text-4xl">Replace the template story with verified hotel history.</h2><p class="mt-5 text-sm leading-7 text-[var(--muted)]">Use this section for the hotel's origin, philosophy, architecture, sustainability work or local connection. The AI customization workflow should modify data first and preserve reusable components.</p></div></div></div></section></BaseLayout>
