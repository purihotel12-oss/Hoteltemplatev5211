---
import type { Experience } from '../data/types';
const { experience, index = 1 } = Astro.props as { experience: Experience; index?: number };
---
<article class="border-t border-white/15 pt-5"><p class="text-xs text-white/40">{String(index).padStart(2,'0')}</p>{experience.image && <img src={experience.image} alt={experience.title} width="1200" height="900" loading="lazy" class="mt-5 aspect-[4/3] w-full object-cover" />}<h3 class="font-display mt-6 text-3xl">{experience.title}</h3><p class="mt-3 text-sm leading-6 text-white/60">{experience.description}</p></article>
