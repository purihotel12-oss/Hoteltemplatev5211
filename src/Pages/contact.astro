---
import BaseLayout from '../layouts/BaseLayout.astro'; import SectionHeading from '../components/SectionHeading.astro'; import { hotel } from '../data/hotel'; import { bookingHref,bookingLabel } from '../lib/booking';
---
<BaseLayout title="Contact"><section class="pt-40 pb-28"><div class="container-hotel"><SectionHeading eyebrow="Contact" title="Let's plan the stay"/><div class="mt-14 grid gap-12 lg:grid-cols-[.8fr_1.2fr]"><div class="space-y-8"><div><p class="eyebrow text-[var(--accent)]">Phone</p><p class="mt-2">{hotel.contact.phone}</p></div><div><p class="eyebrow text-[var(--accent)]">Email</p><p class="mt-2">{hotel.contact.email}</p></div><div><p class="eyebrow text-[var(--accent)]">Address</p><p class="mt-2 leading-7">{hotel.address.address}, {hotel.address.city}, {hotel.address.state}</p></div></div><form class="grid gap-5 border-t border-black/10 pt-6" onsubmit="return false"><label class="text-sm">Name<input required class="mt-2 w-full border border-black/15 bg-transparent p-4"/></label><label class="text-sm">Email<input type="email" required class="mt-2 w-full border border-black/15 bg-transparent p-4"/></label><label class="text-sm">Message<textarea required rows="5" class="mt-2 w-full border border-black/15 bg-transparent p-4"></textarea></label><button class="w-fit bg-[var(--ink)] px-6 py-4 text-xs font-bold uppercase tracking-[.16em] text-white">Send enquiry</button><p class="text-xs text-[var(--muted)]">Frontend-only demo. Connect an approved external endpoint before production.</p></form></div></div></section></BaseLayout>
